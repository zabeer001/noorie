# Production deployment plus the Noorie theme and approved Glifnode plugins.
# WordPress core, runtime data, WooCommerce, and other third-party extensions
# are installed after cloning and stay outside version control.

# Ignore everything at the project root by default.
/*

# Keep this allowlist file.
!/.gitignore
!/README.md
# Local-only Compose configuration; production uses compose.prod.yaml.
/docker-compose.yaml
!/compose.prod.yaml
!/Caddyfile
!/.env.example
!/.env.production.example

# Never commit local secrets or machine-specific environment overrides.
/.env
/.env.*
!/.env.example
!/.env.production.example

# Traverse only as far as the approved wp-content locations.
!/wordpress/
/wordpress/*
!/wordpress/wp-content/
/wordpress/wp-content/*

# Noorie theme.
!/wordpress/wp-content/themes/
/wordpress/wp-content/themes/*
!/wordpress/wp-content/themes/noorie/
!/wordpress/wp-content/themes/noorie/**

# Plugins are denied by default. Add each verified Glifnode plugin below.
!/wordpress/wp-content/plugins/
/wordpress/wp-content/plugins/*

# Glifnode plugin allowlist examples (uncomment and use the real folder name):
# !/wordpress/wp-content/plugins/glifnode-plugin-name/
# !/wordpress/wp-content/plugins/glifnode-plugin-name/**
