# Public hostname only; do not include https:// or a trailing slash.
DOMAIN=shop.example.com
ACME_EMAIL=admin@example.com

# Replace every password before starting the production stack.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=noorie
MYSQL_USER=noorie
MYSQL_PASSWORD=replace-with-a-long-random-database-password

WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=0
